{
  "name": "nls-review-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local CLI to automate frontend code review in NLS (Jira + Bitbucket + git worktree + Claude CLI).",
  "bin": {
    "nls-review": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "gui:install": "npm install && npm --prefix web install",
    "build:web": "npm --prefix web run build",
    "build:gui": "npm run build && npm run build:web",
    "gui": "npm run build && npm run build:web && node dist/server/server.js",
    "gui:serve": "node dist/server/server.js",
    "dev:gui": "node scripts/dev-gui.mjs"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "commander": "^12.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "fs-extra": "^11.2.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.16.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
